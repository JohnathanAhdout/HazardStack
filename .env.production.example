# SPIRAL Production Environment Configuration

# ================================
# API Configuration
# ================================
API_URL=https://api.spiral.app
API_PORT=8000
API_WORKERS=4
API_KEY_SECRET=your-secret-key-here-change-in-production

# ================================
# Database
# ================================
DATABASE_URL=postgresql://spiral:PASSWORD@db.spiral.app:5432/spiral
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ================================
# Redis Cache
# ================================
REDIS_URL=redis://redis.spiral.app:6379
REDIS_TTL=3600

# ================================
# Model Configuration
# ================================
MODEL_PATH=/app/models
EARTHQUAKE_MODEL=models/eq_v1.pt
FLOOD_MODEL=models/flood_v1.pt
RAIN_MODEL=models/rain_v1.pt

# ================================
# Data Sources
# ================================
USGS_API_URL=https://earthquake.usgs.gov/fdsnws/event/1
IMD_DATA_URL=https://imdpune.gov.in/
MOSDAC_URL=https://www.mosdac.gov.in/
CWC_URL=https://ffs.india-water.gov.in/
NCS_URL=https://seismo.gov.in/

# ================================
# Web App
# ================================
NEXT_PUBLIC_API_URL=https://api.spiral.app
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
NEXT_TELEMETRY_DISABLED=1

# ================================
# Mobile App
# ================================
EXPO_PUBLIC_API_URL=https://api.spiral.app
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ================================
# Monitoring
# ================================
SENTRY_DSN=https://your-sentry-dsn
PROMETHEUS_PORT=9090

# ================================
# Security
# ================================
CORS_ORIGINS=https://spiral.app,https://www.spiral.app
RATE_LIMIT=100/minute
JWT_SECRET=your-jwt-secret-here

# ================================
# Feature Flags
# ================================
ENABLE_EARTHQUAKE=true
ENABLE_FLOOD=true
ENABLE_RAIN=true
ENABLE_GRAVITY_WAVES=true
ENABLE_NOTIFICATIONS=true

# ================================
# Logging
# ================================
LOG_LEVEL=info
LOG_FORMAT=json
