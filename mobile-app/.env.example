# SPIRAL Mobile App Environment Variables

# API Backend URL
# IMPORTANT: For mobile app testing, use your computer's IP address, NOT localhost
# Find your IP:
#   macOS/Linux: ifconfig | grep "inet " | grep -v 127.0.0.1
#   Windows: ipconfig

# For local development:
# Replace YOUR_IP with your actual IP address (e.g., 192.168.1.100)
EXPO_PUBLIC_API_URL=http://YOUR_IP:8000

# For production deployment:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com

# Note: The mobile app works with mock data if the API is not available
# You can start using it immediately without setting up the backend
