# HazardStack Environment Variables

# Database
DATABASE_URL=postgresql://hazard:hazard@localhost:5432/hazardstack

# Redis
REDIS_URL=redis://localhost:6379

# API
API_HOST=0.0.0.0
API_PORT=8000

# Model paths
RAIN_MODEL_PATH=models/rain_v1.onnx
FLOOD_MODEL_PATH=models/flood_v1.onnx
EQ_MODEL_PATH=models/eq_v1.onnx

# Data sources (API keys if needed)
MOSDAC_API_KEY=
CWC_API_KEY=
NCS_API_KEY=

# Push notifications
FCM_KEY_PATH=secrets/fcm_key.json
APNS_KEY_PATH=secrets/apns_key.p8

# Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=
